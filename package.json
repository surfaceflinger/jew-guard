{
  "name": "jew-guard",
  "version": "0.9.0",
  "description": "Opencode-only security guard: every tool call risk-scored and every tool result scanned by Jev (TypeSafe System One) over the Console gateway with your existing OpenCode credential. Zero-config: no keys, no key files.",
  "type": "module",
  "main": "./src/opencode.js",
  "bin": {
    "jew-guard": "./bin/jew-guard"
  },
  "exports": {
    ".": "./src/opencode.js",
    "./guard": "./src/guard.js",
    "./jev": "./src/jev.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.5"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "typesafe",
    "system-one",
    "security",
    "prompt-injection"
  ],
  "author": "surfaceflinger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surfaceflinger/jew-guard.git"
  },
  "homepage": "https://github.com/surfaceflinger/jew-guard#readme",
  "license": "MIT"
}
