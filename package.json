{
  "name": "jew-guard",
  "version": "0.12.0",
  "description": "Opencode-only security guard: every tool call risk-scored and every tool result scanned by a decision model (TypeSafe System One, OpenRouter decisions, or any compatible endpoint) using your existing OpenCode credential. Zero-config: no keys, no key files.",
  "type": "module",
  "main": "./src/opencode.js",
  "bin": {
    "jew-guard": "bin/jew-guard"
  },
  "exports": {
    ".": "./src/opencode.js",
    "./guard": "./src/guard.js",
    "./decision": "./src/decision.js",
    "./rpc": "./src/rpc.js",
    "./tui": "./src/tui.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "decision-model",
    "typesafe",
    "system-one",
    "security",
    "prompt-injection"
  ],
  "author": "surfaceflinger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surfaceflinger/jew-guard.git"
  },
  "homepage": "https://github.com/surfaceflinger/jew-guard#readme",
  "license": "MIT",
  "devDependencies": {
    "solid-js": "^1.9.19"
  }
}
